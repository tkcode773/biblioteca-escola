# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA deve ser enviado para o GitHub.

# Chave da API do River AI (usada apenas pelo Chat IA).
# Sem ela, o chat mostra uma mensagem de aviso e o resto do site funciona normal.
RIVER_API_KEY=
RIVER_MODEL=Qwen/Qwen3.5-9B

# Segredo do NextAuth (a rota /api/auth/... existe no projeto mas não é usada pela
# interface). Se for usar, gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
